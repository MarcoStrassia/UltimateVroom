	(text "TARGET: 12S1P A123 26650 + two Boosted Board V1 motors. Exact cell revision and motor ratings still to confirm."
		(at 840.74 385 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "0b260c4c-f85e-4585-ba45-abcb52cdcb2c")
	)
	(text "M2: TIM3 PA6/PA7/PB0 PWM; PB6/PB7/PB8 enables; PB1 ADC9 current. TIM1 remains motor1. No firmware yet."
		(at 840.74 395 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "a9cb8f9d-92c7-4a00-a8c7-685eb12cbedb")
	)
	(text "Each bridge: 2 x 10mOhm parallel, gain20 => 0.100V/A; nominal trip 24.775A. Overcurrent trip threshold only, not a set motor current limit."
		(at 840.74 405 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "52f84a9f-d0a9-403d-80d0-ff1afa48e7b2")
	)
	(text "Single low-side shunt: synchronous sampling/reconstruction required; blind switching states and reverse/regen current not covered by INA180."
		(at 840.74 415 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "6730d540-ae9e-46eb-95b4-2235395ee2a1")
	)
	(text "Shared 20A fuse is not an electronic battery limiter. Pack/BMS charge, discharge, cold-temperature and cell imbalance limits remain required."
		(at 840.74 425 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "c27101d2-e90d-4f85-abfc-e31ca3ac3dbd")
	)
	(text "9mF at43.2V stores8.398J. External precharge/contact sequencing needed. No automatic precharge on the board."
		(at 840.74 435 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "716a4953-aaa7-406d-8d42-f326c5acec2e")
	)
	(text "LM74500:60V recommended /65V absolute max;43.2V steady state compatible; SMCJ45A 72.7V clamp is above that limit. Keep regen off until BMS and energy handling are sorted."
		(at 840.74 445 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "2a067c77-ac72-453a-835f-610333bed4de")
	)
