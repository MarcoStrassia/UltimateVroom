		(property "Description" "Vishay SiR512DP: N-channel 100 V TrenchFET Gen V power MOSFET, 100 A package limit, RDS(on) 4.5 mOhm max at VGS 10 V (Vishay doc 63091 Rev C, 04-Dec-2023), PowerPAK SO-8 single; S pins 1-3, G pin 4, D pins 5-8 and exposed drain tab"
			(at 152.4 175.26 0)
			(effects
				(font
					(size 1 1)
				)
