		(property "Description" "8-Bit Single-Supply Bus Transceiver With 5V tolerant input voltage and 3-State Outputs 24mA, TSSOP-20"
			(at 80.01 129.54 0)
			(effects
				(font
					(size 1 1)
				)
				(hide yes)
			)
		)
		(property "MPN" "DRV8300UDPWR"
			(at 80.01 129.54 0)
			(effects
				(font
