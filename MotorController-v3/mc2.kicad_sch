			(at 72.39 16.51 0)
			(effects
				(font
					(size 1 1)
				)
				(hide yes)
			)
		)
		(property "Wright.Note" "Footprint Inductor_SMD:L_Bourns-SRN6028 is the KiCad library pattern for the Bourns SRN6028 series (two 1.6 x 5.7 mm pads at 4.7 mm pitch); taken from the maintained library, not fabrication-qualified by Wright."
			(at 72.39 16.51 0)
