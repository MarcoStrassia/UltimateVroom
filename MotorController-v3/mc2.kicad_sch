		(property "Description" "STMicroelectronics STM32G474RET6: Arm Cortex-M4 170 MHz, 512 KB flash, TIM1/TIM8/TIM20 advanced timers with dead-time and BKIN, 5 x 12-bit ADC, LQFP-64"
			(at 350.52 149.86 0)
			(effects
				(font
					(size 1 1)
				)
				(hide yes)
			)
		)
		(property "MPN" "STM32G474RET6"
			(at 350.52 149.86 0)
			(effects
